# AI Order Assistant (Modules/AIAssistant) — provider credentials are
# platform-managed via Admin > AI Providers, not env vars; this only
# controls where the assistant's background jobs (usage logging, WhatsApp
# delivery) run. Leave unset to use QUEUE_CONNECTION.
QUEUE_CONNECTION_AI=

# Order-notification WhatsApp channel (Meta Cloud API) — see
# app/Services/WhatsApp/MetaCloudWhatsAppProvider.php
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v20.0

NGINX_PORT=8302
FORCE_HTTPS=true
CONTAINER_NAME_PREFIX=6valley-demo
